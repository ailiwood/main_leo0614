graph TD
    subgraph Input
        TEXT["Text Input<br/>[B, 128] token ids"]
        AUDIO["Audio Input<br/>[B, 100, 74] COVAREP"]
    end

    subgraph Text_Encoder
        ROBERTA["RoBERTa-large + LoRA<br/>r=16, alpha=32<br/>355M params (1.6M trainable)"]
        TEXT_MLP["Text MLP<br/>1024 -> 512 -> 256<br/>LN + GELU + Dropout"]
        H_T["h_t [B, 256]"]
    end

    subgraph Audio_Encoder
        A_PROJ["Audio Projection<br/>Linear(74->256)<br/>LN + GELU"]
        SLSTM["sLSTM Encoder<br/>1-layer, mask-aware<br/>exponential gating<br/>525K params"]
        A_POOL["MaskedAttentionPooling<br/>34K params"]
        H_A["h_a [B, 256]"]
    end

    subgraph AWAF_Fusion["AWAF Fusion (627K params)"]
        CTX["Cross-Modal Context<br/>h_t attends h_a<br/>h_a attends h_t"]
        ENH["Context Enhancement<br/>h_t = LN(h_t + c_t)<br/>h_a = LN(h_a + c_a)"]
        INTER["Second-Order Interaction<br/>g_ta = h_t x h_a (Hadamard)"]
        SCORE["Weight Scoring<br/>e = MLP([h_t, h_a, g_ta])<br/>w = softmax(e/tau)<br/>tau=3.0"]
        FUSE["Weighted Fusion<br/>z = w_t*h_t + w_a*h_a"]
    end

    subgraph Head
        CANON_HEAD["Canonical Head<br/>Linear(256->128)+ReLU<br/>Linear(128->1)<br/>33K params"]
        OUTPUT["y_hat [B, 1]<br/>Sentiment [-3, +3]"]
    end

    subgraph Outputs
        PRED["predictions_test.csv"]
        WEIGHTS["awaf_weights_test.csv<br/>[w_t, w_a, w_v] per sample"]
    end

    TEXT --> ROBERTA
    ROBERTA --> TEXT_MLP
    TEXT_MLP --> H_T

    AUDIO --> A_PROJ
    A_PROJ --> SLSTM
    SLSTM --> A_POOL
    A_POOL --> H_A

    H_T --> CTX
    H_A --> CTX
    CTX --> ENH
    ENH --> INTER
    INTER --> SCORE
    SCORE --> FUSE

    H_T --> FUSE
    H_A --> FUSE

    FUSE --> CANON_HEAD
    CANON_HEAD --> OUTPUT

    OUTPUT --> PRED
    SCORE --> WEIGHTS

    style ROBERTA fill:#e1f5fe
    style SLSTM fill:#fff3e0
    style AWAF_Fusion fill:#fce4ec
    style CANON_HEAD fill:#e8f5e9
